# ローカル開発用の環境変数の雛形。
#
# 本番/staging の値の注入経路は wrangler.toml の [vars]（機密でない値）と
# `wrangler secret put --env <env>`（機密値）であり、このファイルではない（§7-7）。
# ここに本番相当の値を書かない。
#
# 使い方: cp .env.example .env.local （.env* は .gitignore 済み）
#
# 下の 2 つの節は機械可読な印（>>> ... >>> / <<< ... <<<）で区切ってある。
# tests/integration/schema.test.ts が「ランタイム欄に特権クレデンシャルが無いこと」を
# この印を頼りに検査する（check_069 / R-SEC-03）。印を消さないこと。

# >>> runtime (cloudflare workers) >>>
# ★ この節に列挙してよいのは、ランタイム（Workers）に渡る変数だけ。
# ★ DB 接続文字列をこの節に置かない。Workers は wrangler.toml の [[hyperdrive]]
#    バインディング（env.HYPERDRIVE.connectionString）から接続文字列を受け取る。
# ★ service role キー・postgres スーパーユーザー・マイグレーション用の資格情報を
#    この節に絶対に置かない。ランタイムのロールは最小権限の app_rw だけである。
APP_ENV=development
# <<< runtime <<<

# >>> local-and-migration-only (never reaches the workers runtime) >>>
# ローカルで `next dev` を動かすときにアプリが使う直接接続。ロールは app_rw。
# パスワードは supabase/migrations では設定せず、ローカルは
# `npm run test:integration` のセットアップが app_rw に設定する（既定値 app_rw_local_dev_only）。
DATABASE_URL=postgresql://app_rw:app_rw_local_dev_only@127.0.0.1:54322/postgres

# マイグレーション・ゲート同期・統合テストのセットアップだけが使う特権接続。
# `supabase start` の既定値。CI も同じ形（ポートは supabase/config.toml の [db] port）。
DATABASE_URL_MIGRATOR=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ローカル / CI の app_rw パスワード。ローカル専用のダミー値であり、本番・staging では
# 秘密ストアから `ALTER ROLE app_rw PASSWORD ...` で投入する（task_024 / task_035）。
APP_RW_PASSWORD=app_rw_local_dev_only
# <<< local-and-migration-only <<<
