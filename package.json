{
  "name": "cashapp",
  "version": "0.1.0",
  "description": "kanji-kaihi-line-miniapp — LINE ミニアプリ基盤（Cloudflare Workers / OpenNext）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:changed": "files=$(git diff --name-only --diff-filter=ACMR HEAD -- \"*.ts\" \"*.tsx\"; git diff --cached --name-only --diff-filter=ACMR -- \"*.ts\" \"*.tsx\"; git ls-files --others --exclude-standard -- \"*.ts\" \"*.tsx\"); files=$(echo \"$files\" | grep -E \"[.]tsx?$\" | sort -u | tr \"\\n\" \" \"); if [ -z \"$files\" ]; then echo \"lint:changed: 対象なし（HEAD との差分・ステージ済み差分・未追跡ファイルに .ts / .tsx がありません）\"; else echo \"lint:changed: $files\"; eslint --max-warnings=0 $files; fi",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build && node scripts/ci/record-worker-size.mjs",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "test:unit": "TZ=UTC vitest run tests/unit",
    "test:e2e": "playwright test tests/e2e",
    "test:security": "TZ=UTC vitest run tests/security",
    "test:a11y": "playwright test tests/a11y",
    "gate:constraints": "bash scripts/gate-constraints.sh",
    "gate:wording": "node scripts/wording-lint.mjs",
    "db:migrate": "supabase migration up --local",
    "db:reset:local": "supabase db reset --local",
    "test:integration": "TZ=UTC vitest run tests/integration --testTimeout=60000 --hookTimeout=60000",
    "gates:sync": "node scripts/gates-sync.mjs",
    "db:diff:drizzle": "D=node_modules/.cache/drizzle-diff/run-$(date +%s) && mkdir -p $D && DRIZZLE_DIFF_OUT=$D drizzle-kit pull && DRIZZLE_DIFF_OUT=$D drizzle-kit generate && node scripts/db-diff-drizzle.mjs $D",
    "gate:env": "node scripts/gate-env-scope.mjs",
    "gate:server-only": "node scripts/assert-server-only.mjs",
    "gate:check": "node scripts/gate-check.mjs",
    "gate:plan": "node scripts/validate-plan-json.mjs",
    "gate:acceptance": "node scripts/assert-acceptance.mjs",
    "gate:integrity": "node scripts/gate-integrity.mjs",
    "test:gate-meta": "TZ=UTC vitest run tests/gates",
    "gate:release-gate": "node scripts/ci/assert-release-gate.mjs",
    "gate:pr-checklist": "node scripts/ci/check-pr-checklist.mjs",
    "gate:secrets-grep": "bash scripts/ci/secrets-grep.sh",
    "review:packet": "bash scripts/build-review-packet.sh",
    "review:gemini": "node scripts/review-gemini.mjs",
    "review:gpt": "node scripts/review-gpt.mjs",
    "review:validate": "node scripts/validate-findings.mjs",
    "review:merge": "bash scripts/merge-review.sh",
    "build:web-only": "node scripts/build-web-only.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@line/liff": "2.31.0",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@line/liff-mock": "1.0.4",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.137.0",
    "yaml": "2.9.1"
  }
}
